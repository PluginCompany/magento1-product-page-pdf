<div class="pc-font-select">
    <?php foreach($this->getFontData() as $fontData){ ?>
        <div data-identifier="<?php echo $fontData['identifier']; ?>"
             class="select-image select-image-<?php echo $fontData['identifier']; ?>">
            <img src='data:image/png;base64, <?php echo $fontData['image_base64']; ?>'>
        </div>
    <?php } ?>
</div>
<style>
    .pc-font-select {
        float:left;
        clear:both;
        max-height:400px;
        width:280px;
        overflow-y:scroll;
        background:white;
        position:relative;
    }
    .pc-font-select .select-image {
        float:left;
        clear:both;
        width:100%;
        box-sizing:border-box;
        overflow:hidden;
        padding-left:10px;
        border:3px solid #fff;
    }
    .pc-font-select .select-image.selected {
        border:3px solid #7cdbff;
        border-radius:4px;
    }
    .pc-font-select img {
        float:left;
        clear:both;
    }
</style>

<script type="text/javascript">
    $PC(document).ready(function($){
        var currentValue = $('#<?php echo $this->getElementHtmlId(); ?>').val();
        var currentSelectedEm = $('#<?php echo $this->getElementHtmlId(); ?>')
            .parent()
            .find('.select-image-' + currentValue);
        if(currentSelectedEm.length){
            currentSelectedEm.addClass('selected');
            $('#<?php echo $this->getElementHtmlId(); ?>')
                .parent()
                .find('.pc-font-select')
                .scrollTop(currentSelectedEm.position().top - 110);
        }

        $('#<?php echo $this->getElementHtmlId(); ?>').parent().find('.select-image')
            .click(function(){
                $(this).parent().children().removeClass('selected');
                $(this).addClass('selected');
                $('#<?php echo $this->getElementHtmlId(); ?>').val($(this).data('identifier'));
            })
    })
</script>